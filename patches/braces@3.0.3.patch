diff --git a/lib/guard-depth.js b/lib/guard-depth.js
new file mode 100644
index 0000000..d19876c
--- /dev/null
+++ b/lib/guard-depth.js
@@ -0,0 +1,11 @@
+'use strict';
+
+// Local security patch for GHSA-vfj7-8cjw-p6xm. Keep recursive AST walkers
+// bounded independently of pattern length and caller-supplied options.
+module.exports = depth => {
+  if (depth > 128) {
+    const error = new SyntaxError('Brace pattern exceeds maximum nesting depth (128)');
+    error.code = 'BRACES_MAX_DEPTH';
+    throw error;
+  }
+};
